<?xml version="1.0" encoding="utf-8"?>
<!-- The Inkbound mark: an open book with a crimson ink stroke across it.
     108dp canvas with the artwork inside the central 66%, so no launcher mask
     (circle, squircle, rounded) can clip it. Kept as a vector so one file serves
     every density; the PNG fallbacks in mipmap-* are generated from the same
     geometry. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left leaf. Spine edge stops short of centre so the two leaves keep a
         visible gap; without it they merge into one blob at 48px. -->
    <path
        android:fillColor="#F4EEE4"
        android:pathData="M52.65,29.65 C47.0,31.2 39.0,32.4 32.0,33.5 C27.5,34.2 23.5,34.6 18.0,35.1 L18.0,65.0 C23.5,65.5 27.5,66.0 32.0,66.8 C39.0,68.0 47.0,69.4 52.65,70.5 Z" />

    <!-- Right leaf, mirrored. -->
    <path
        android:fillColor="#F4EEE4"
        android:pathData="M55.35,29.65 C61.0,31.2 69.0,32.4 76.0,33.5 C80.5,34.2 84.5,34.6 90.0,35.1 L90.0,65.0 C84.5,65.5 80.5,66.0 76.0,66.8 C69.0,68.0 61.0,69.4 55.35,70.5 Z" />

    <!-- The ink stroke: a tapered ribbon across both leaves. -->
    <path
        android:fillColor="#FF4D57"
        android:pathData="M20.0,60.5 C33.0,55.0 52.0,49.5 69.0,44.0 C75.0,42.3 81.0,41.0 86.0,39.6 C87.6,39.1 88.4,38.4 87.6,38.2 C82.0,37.2 75.0,38.6 68.0,41.4 C51.0,47.0 32.0,53.5 21.0,58.6 C18.6,59.6 18.9,61.2 20.0,60.5 Z" />
</vector>