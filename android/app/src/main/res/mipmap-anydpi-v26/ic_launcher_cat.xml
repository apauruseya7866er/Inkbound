<?xml version="1.0" encoding="utf-8"?>
<!-- Alternate launcher icon: the same open book and ribbon with a cat reading
     it. Carried by the "default" activity-alias and reached second from
     Settings -> Interface.

     Same layer contract as ic_launcher_plain.xml; generated by
     tool/gen_brand_assets.py. The persisted icon id for this slot is still
     "default" and the resource name deliberately does not track it — ids are
     written to prefs on users' phones and cannot be renamed once shipped, but
     which mark an id carries is not frozen. See AppIconService. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_cat_fg" />
    <monochrome android:drawable="@mipmap/ic_launcher_cat_mono" />
</adaptive-icon>
