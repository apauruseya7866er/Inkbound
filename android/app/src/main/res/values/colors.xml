<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand background (AppColors.defaultBg = 0xFF0B0B0F). Used for the native
         launch window so there's no white/black flash before the Flutter splash
         paints — the launch screen matches the app's dark UI. -->
    <color name="launch_bg">#FF0B0B0F</color>
    <!-- The Inkbound ink navy. This is the adaptive icon's flat background
         layer, so it has to sit between the two ends of the plate gradient in
         tool/gen_brand_assets.py (PLATE_TOP / PLATE_BOT) closely enough that
         the masked edge blends into the artwork instead of showing a ring
         around the mark. Change the gradient there and this has to move with
         it. The legacy mipmaps carry the gradient themselves and ignore this. -->
    <color name="ic_launcher_bg">#FF12121F</color>
    <!-- The extension-settings fallback screen (AniyomiSettingsActivity /
         MihonSettingsActivity). Without these it resolves Material's factory
         colours and the header comes out purple. Mirrors AppColors.surface /
         accent / textPrimary. -->
    <color name="settings_surface">#FF16161C</color>
    <color name="settings_accent">#FFFF4D57</color>
    <color name="settings_text">#FFFFFFFF</color>
    <color name="phone_player_background">#FF0B0B0F</color>
    <color name="phone_player_surface">#FF211F29</color>
    <color name="phone_player_surface_container">#FF2B2930</color>
    <color name="phone_player_accent">#FFD0BCFF</color>
    <color name="phone_player_on_primary">#FF381E72</color>
    <color name="phone_player_on_surface">#FFE6E1E5</color>
    <color name="phone_player_on_surface_variant">#FFCAC4D0</color>
    <color name="phone_player_outline">#FF938F99</color>
    <color name="phone_player_scrim">#D90B0B0F</color>
</resources>
